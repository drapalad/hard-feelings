---
import Topbar from "@/components/Topbar.astro";
import SiteFooter from "@/components/SiteFooter.astro";

const { user } = Astro.locals;
---

<div class="bg-cosmic min-h-screen w-full">
  <div class="p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-6 text-5xl leading-tight font-bold text-white sm:text-6xl lg:text-7xl">HardFeelings</h1>
      <p class="mb-10 max-w-2xl text-lg text-blue-100/70 sm:text-xl">Training plans for amateur runners.</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        {
          user ? (
            <a
              href="/dashboard"
              class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
            >
              Open dashboard
            </a>
          ) : (
            <>
              <a
                href="/auth/signin"
                class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
              >
                Sign In
              </a>
              <a
                href="/auth/signup"
                class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
              >
                Sign Up
              </a>
            </>
          )
        }
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Race priorities A–D</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Weekly kilometres and A–D race priorities drive the algorithm — one A-goal plus side events, not a one-size
          week.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Algorithmic generation</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Plans appear fast from the algorithm, not from a chatbot writing your week. Chat proposes; the algorithm
          builds and bounds.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-purple-300"
        >
          <circle cx="18" cy="18" r="3"></circle>
          <circle cx="6" cy="6" r="3"></circle>
          <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
          <path d="M11 18H8a2 2 0 0 1-2-2V9"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-white">Coach chat</h3>
        <p class="text-sm leading-relaxed text-blue-100/60">
          Ask to change a day. Send updates the calendar when the change is in bounds. Soft warnings are yours; hard
          bounds cannot land.
        </p>
      </div>
    </div>

    <SiteFooter />
  </div>
</div>
