---
import { parseDashboardTab } from "@/components/dashboard/dashboard-tabs";
import PlanTabSelect from "@/components/dashboard/PlanTabSelect";

const { user } = Astro.locals;
const isDashboardPath = Astro.url.pathname === "/dashboard" || Astro.url.pathname === "/dashboard/";
const currentPlanTab = isDashboardPath ? parseDashboardTab(Astro.url.searchParams.get("tab")) : null;
const selectTab = currentPlanTab ?? "calendar";
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <div class="sm:hidden">
            <PlanTabSelect client:load currentTab={selectTab} />
          </div>
          <div class="hidden items-center gap-3 sm:flex">
            {currentPlanTab === "calendar" ? (
              <span class="text-white" aria-current="page">
                Calendar
              </span>
            ) : (
              <a
                href="/dashboard?tab=calendar"
                class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >
                Calendar
              </a>
            )}
            {currentPlanTab === "list" ? (
              <span class="text-white" aria-current="page">
                List
              </span>
            ) : (
              <a
                href="/dashboard?tab=list"
                class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >
                List
              </a>
            )}
            {currentPlanTab === "profile" ? (
              <span class="text-white" aria-current="page">
                Profile
              </span>
            ) : (
              <a
                href="/dashboard?tab=profile"
                class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
              >
                Profile
              </a>
            )}
          </div>
          {Astro.locals.isAdmin ? (
            <a href="/admin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Admin
            </a>
          ) : null}
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
