
SUPABASE_URL=###
SUPABASE_KEY=###
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=
# Local code-reviewer CLI (`packages/code-reviewer`) and GitHub Actions review.yml.
# Not astro:env — do not ship to the Worker. Repo secret uses the same name.
OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-4o-mini when unset.
OPENROUTER_MODEL=
# Playwright (optional; local only — not read by `npm test` / CI).
# If unset, auth.setup.ts signs up a fresh member against local Supabase.
E2E_EMAIL=
E2E_PASSWORD=
# Optional. Worker-only error tracking (sentry.server.config.ts). Empty DSN = no-op.
# Put the real value in `.dev.vars` / `wrangler secret put SENTRY_DSN` — not in git.
SENTRY_DSN=
# Optional. Explicit off even when DSN is set (`false` / `0` / `off` / `no`).
# Local and later pre-prod: `false`. Unset = ingest on (production).
SENTRY_ENABLED=
